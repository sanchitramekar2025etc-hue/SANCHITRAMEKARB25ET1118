#include <iostream>
#include <string>
using namespace std;

template <class T>
T maximumValue(T a, T b) {
    return (a > b) ? a : b;
}

template <class T>
class Box {
    T val;
public:
    Box(T v) : val(v) {}
    void show() {
        cout << "Box value = " << val << "\n";
    }
};

int main() {
    cout << "Maximum integer = " << maximumValue(10, 25)   << "\n";
    cout << "Maximum double  = " << maximumValue(2.5, 5.5) << "\n";

    Box<int> b1(100);
    b1.show();

    Box<string> b2("C++ Templates");
    b2.show();
}
