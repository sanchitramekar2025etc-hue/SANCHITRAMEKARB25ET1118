#include <iostream>
#include <stdexcept>
using namespace std;

int main() {
    int a, b;
    cout << "Enter numerator: ";   cin >> a;
    cout << "Enter denominator: "; cin >> b;

    try {
        if (b == 0)
            throw runtime_error("Division by zero is not allowed.");

        cout << "Quotient = " << (float)a / b << "\n";
    } catch (const exception &e) {
        cout << "Exception caught: " << e.what() << "\n";
    }
}
